{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/state-index.schema.json",
  "title": "ICARUS Control State Index",
  "description": "Proposed compact index shape for state.json. This schema does not itself modify the existing state.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_policy_version",
    "repository_revision",
    "active_cycle",
    "latest_handoff",
    "evidence_manifest",
    "claims_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "icarus-state-index-v1"
    },
    "pipeline_policy_version": {
      "const": "icarus-control-v1"
    },
    "policy_epoch": {
      "type": ["string", "integer", "null"]
    },
    "repository_revision": {
      "type": "string"
    },
    "config_digest": {
      "type": ["string", "null"]
    },
    "active_cycle": {
      "type": ["string", "null"]
    },
    "latest_handoff": {
      "type": ["string", "null"]
    },
    "evidence_manifest": {
      "type": ["string", "null"]
    },
    "claims_manifest": {
      "type": ["string", "null"]
    },
    "research_manifest": {
      "type": ["string", "null"]
    },
    "verification_manifest": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
