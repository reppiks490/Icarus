# Copy to the repo root as `.env` (never commit the real file).

# Alpaca paper (default). Live keys + ALPACA_PAPER=false is a different product
# and still not CME — fills are equity proxies (NQ1! → QQQ).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

HOST=0.0.0.0
PORT=8787
WEBHOOK_SECRET=replace-me
ADMIN_TOKEN=replace-me-too

# mirror = TV is the brain (recommended)
# bracket = broker owns TP/SL
# shadow  = in-memory, no Alpaca
EXECUTION_MODE=mirror

# NQ1!:QQQ is the default. This is NOT a 1:1 futures fill.
# SYMBOL_MAP=NQ1!:QQQ,ES1!:SPY,YM1!:DIA
LEVERAGE_FACTOR=1.0
SIZING_MODE=notional
NOTIONAL_PER_CONTRACT_USD=20000
MAX_POSITION_SHARES=400
DAILY_LOSS_LIMIT_USD=2000
ALLOW_EXTENDED_HOURS=false
PROTECTIVE_STOP=true
