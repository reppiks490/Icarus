# Grok (xAI) — 2026-09-20. Whole file. The plant copies this to $ICARUS_HOME/.env;
# standalone bridge users may copy it to the repo root as .env. Never commit the real file.

# Alpaca paper (default). Live keys + ALPACA_PAPER=false is a different product
# and still not CME — fills are equity proxies (NQ1! → QQQ).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

HOST=127.0.0.1
PORT=8787
WEBHOOK_SECRET=replace-me
ADMIN_TOKEN=replace-me-too

# mirror = TV is the brain (recommended)
# bracket = broker owns TP/SL
# shadow  = in-memory, no Alpaca
EXECUTION_MODE=mirror

# NQ1!:QQQ is the default. This is NOT a 1:1 futures fill.
# SYMBOL_MAP=NQ1!:QQQ,ES1!:SPY,YM1!:DIA
LEVERAGE_FACTOR=1.0
SIZING_MODE=notional
NOTIONAL_PER_CONTRACT_USD=20000
MAX_POSITION_SHARES=400
DAILY_LOSS_LIMIT_USD=2000
ALLOW_EXTENDED_HOURS=false
PROTECTIVE_STOP=true


# MCP control surface endpoints. ICARUS_ENGINE_TOKEN may be the same admin token
# as the paper engine; keep real tokens in your local environment, never in git.
ICARUS_BRIDGE_URL=http://127.0.0.1:8787
# Blank falls back to ADMIN_TOKEN above.
ICARUS_ADMIN_TOKEN=
ICARUS_ENGINE_URL=http://127.0.0.1:8791
# Set this to the paper-engine --token. Blank falls back to ICARUS_ADMIN_TOKEN/ADMIN_TOKEN.
ICARUS_ENGINE_TOKEN=


# Databento CME Globex market data (used by: icarus-plant start --databento)
# Keep the real key only in your local $ICARUS_HOME/.env.
DATABENTO_API_KEY=
